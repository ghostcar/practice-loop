# =============================================================================
# Practice Loop — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Docker Compose uses PostgreSQL in both production and development because
# the Alembic migrations contain PostgreSQL-specific types such as JSONB.
# For hot reload, add the explicit development override:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
# =============================================================================

# --- Database ---
# Local Python/unit-test development only (not Docker migrations):
DATABASE_URL=sqlite+aiosqlite:///./tracker.db
# Production (PostgreSQL via docker compose):
# DATABASE_URL=postgresql+asyncpg://tracker:YOUR_PASSWORD@localhost:5432/tracker

# --- JWT Authentication ---
# REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Mobile Foundation (M4): refresh tokens + push ---
REFRESH_TOKEN_EXPIRE_DAYS=30
# Push provider: none (disabled) | logging (log-only, dev) | fcm | apns
PUSH_PROVIDER=none

# --- Encryption (separate from JWT) ---
# REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIALS_ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars

# --- Verification challenges (HMAC) ---
# REQUIRED in production (separate from JWT/ENCRYPTION).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHALLENGE_HMAC_KEY=change-me-challenge-hmac-key-at-least-32-chars

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Telegram (optional) ---
# TG_BOT_TOKEN=123456:ABC-DEF1234ghikl
# TG_WEBHOOK_SECRET=change-me
# TG_WEBHOOK_BASE_URL=https://your-domain.com
# TG_BOT_USERNAME=your_bot_username
# TG_POLLING=false       # true = polling (local dev), false = webhook (production)
# TG_AUTO_ANALYSIS_TIME=23:00   # HH:MM — daily training analysis time
# TG_AUTO_ANALYSIS_TZ=UTC       # IANA timezone for the analysis time + "today" day boundary

# --- Docker Compose (production only) ---
# POSTGRES_DB=tracker
# POSTGRES_USER=tracker
# POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
# POSTGRES_PORT=5432
# HTTP_PORT=8080
# HTTPS_PORT=8443

# === Omniroute (ADR-002/070) — локальный LLM-прокси на хосте ===
# Используется: 1) порталом — seed LLM-пресета Omniroute (host+key, шифруется),
# 2) memoryctl index-code/search-code для эмбеддингов (OMNIROUTE_EMBEDDING_MODEL, ADR-069).
OMNIROUTE_HOST=llm.gorbunovr.ru
OMNIROUTE_API_KEY=
# OMNIROUTE_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small

