# =============================================================================
# Practice Loop — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# For development with SQLite, only DATABASE_URL is needed.
# For production with PostgreSQL (via docker compose), fill all variables.
# =============================================================================

# --- Database ---
# Development (SQLite, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./tracker.db
# Production (PostgreSQL via docker compose):
# DATABASE_URL=postgresql+asyncpg://tracker:YOUR_PASSWORD@localhost:5432/tracker

# --- JWT Authentication ---
# REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Encryption (separate from JWT) ---
# REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIALS_ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Telegram (optional) ---
# TG_BOT_TOKEN=123456:ABC-DEF1234ghikl
# TG_WEBHOOK_SECRET=change-me
# TG_WEBHOOK_BASE_URL=https://your-domain.com
# TG_BOT_USERNAME=your_bot_username
# TG_POLLING=false       # true = polling (local dev), false = webhook (production)
# TG_AUTO_ANALYSIS_TIME=23:00   # HH:MM UTC — daily training analysis

# --- Docker Compose (production only) ---
# POSTGRES_DB=tracker
# POSTGRES_USER=tracker
# POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
# POSTGRES_PORT=5432
# HTTP_PORT=8080
# HTTPS_PORT=8443
